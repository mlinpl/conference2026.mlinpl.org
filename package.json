{
  "name": "conference2026.mlinpl.org",
  "scripts": {
    "build": "docker build -t conference2026.mlinpl.org .",
    "run": "docker run --name conference2026-mlinpl-container --rm -p 127.0.0.1:4000:4000 conference2026.mlinpl.org",
    "run:livereload": "docker run --name conference2026-mlinpl-container --rm -e JEKYLL_LIVERELOAD=\"--livereload\" -p 127.0.0.1:4000:4000 -p 127.0.0.1:35729:35729 conference2026.mlinpl.org",
    "open:win": "start http://localhost:4000",
    "open:linux": "xdg-open http://localhost:4000",
    "open:mac": "open http://localhost:4000",
    "stop": "docker stop conference2026-mlinpl-container"
  }
}