{
  "name": "conference2026.mlinpl.org",
  "scripts": {
    "dev": "bash run_locally.sh",
    "images:optimize": "bash scripts/optimize_images.sh",
    "docker:build": "docker build -t conference2026.mlinpl.org .",
    "docker:run": "docker run --name conference2026-mlinpl-container --rm -p 127.0.0.1:4000:4000 conference2026.mlinpl.org",
    "docker:run:livereload": "docker run --name conference2026-mlinpl-container --rm -e JEKYLL_LIVERELOAD=\"--livereload\" -p 127.0.0.1:4000:4000 -p 127.0.0.1:35729:35729 conference2026.mlinpl.org",
    "docker:stop": "docker stop conference2026-mlinpl-container"
  }
}
