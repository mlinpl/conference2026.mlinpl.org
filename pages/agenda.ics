---
layout: null
permalink: /agenda.ics
---
BEGIN:VCALENDAR
VERSION:2.0
PRODID:-//ML in PL//Conference Agenda//EN
CALSCALE:GREGORIAN
METHOD:PUBLISH
X-WR-CALNAME:{{ site.title }}
X-WR-TIMEZONE:Europe/Warsaw
BEGIN:VTIMEZONE
TZID:Europe/Warsaw
BEGIN:DAYLIGHT
TZOFFSETFROM:+0100
TZOFFSETTO:+0200
TZNAME:CEST
DTSTART:19700329T020000
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=-1SU
END:DAYLIGHT
BEGIN:STANDARD
TZOFFSETFROM:+0200
TZOFFSETTO:+0100
TZNAME:CET
DTSTART:19701025T030000
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU
END:STANDARD
END:VTIMEZONE
{%- assign stamp = site.time | date: "%Y%m%dT%H%M%SZ" -%}
{%- for day in site.data.agenda -%}
{%- for session in day.sessions -%}
{%- for event in session.events -%}
{%- assign event_key = "e" | append: forloop.index -%}
{%- include calendar/event-fields.html day=day event=event key=event_key -%}
{%- include calendar/vevent.ics -%}
{%- for subevent in event.subevents -%}
{%- assign subevent_key = event_key | append: "-" | append: forloop.index -%}
{%- include calendar/event-fields.html day=day event=subevent parent=event key=subevent_key -%}
{%- include calendar/vevent.ics -%}
{%- endfor -%}
{%- endfor -%}
{%- endfor -%}
{%- endfor %}
END:VCALENDAR
